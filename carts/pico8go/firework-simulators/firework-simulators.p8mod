pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- firework simulators
-- by hp7hao and codex

fw={
 {"fountain",8,"fan jets from ground","d_fountain"},
 {"roman",10,"repeating colored shots","d_roman"},
 {"shell",9,"rise then burst","d_shell"},
 {"peony",14,"round floral burst","d_peony"},
 {"chrys",7,"long glitter spokes","d_chrys"},
 {"willow",6,"falling golden trails","d_willow"},
 {"palm",12,"thick comet arms","d_palm"},
 {"ring",11,"hollow circle burst","d_ring"},
 {"crackle",15,"small noisy stars","d_crackle"},
 {"finale",13,"many cakes at once","d_finale"}
}

function _init()
 _txi()
 sel=1
 pow=2
 t=0
 show_info=true
 ps={}
 jobs={}
 stars={}
 for i=1,46 do
  add(stars,{rnd(128),rnd(66),rnd(2)})
 end
 launch(sel)
end

function _update()
 t+=1
 if btnp(0) then sel=(sel+8)%10+1 end
 if btnp(1) then sel=sel%10+1 end
 if btnp(2) then pow=min(3,pow+1) end
 if btnp(3) then pow=max(1,pow-1) end
 if btnp(4) then launch(sel) end
 if btnp(5) then show_info=not show_info end
 update_jobs()
 update_particles()
 if t%90==0 and #ps<90 then sparkle(rnd(128),20+rnd(50),1,5,1) end
end

function _draw()
 cls(0)
 draw_sky()
 draw_particles()
 rectfill(0,100,127,127,1)
 line(0,100,127,100,5)
 tx("title",2,2,7)
 print("< >",2,111,6)
 tx("select",17,111,6)
 print("x",64,111,8)
 tx("fire",73,111,8)
 print("o",101,111,12)
 tx("inspect",110,111,12)
 draw_panel()
end

function draw_sky()
 for s in all(stars) do
  pset(s[1],s[2],s[3]+5)
 end
 for x=0,127,8 do
  line(x,101,x+4,97,5)
 end
end

function draw_panel()
 local f=fw[sel]
 rectfill(0,82,127,99,0)
 rect(0,82,127,99,5)
 tx(f[1],3,85,f[2])
 print("lv "..pow,104,85,7)
 if show_info then
  tx(f[4],3,93,6)
 else
  print(f[3],3,93,6)
 end
end

function part(x,y,dx,dy,c,life,g,kind)
 if #ps<180 then
  add(ps,{x=x,y=y,dx=dx,dy=dy,c=c,l=life,g=g or .04,k=kind or 0})
 end
end

function update_particles()
 for p in all(ps) do
  p.x+=p.dx
  p.y+=p.dy
  p.dy+=p.g
  p.l-=1
  if p.k==1 and p.l%5==0 then part(p.x,p.y,rnd(1)-.5,rnd(1)-.5,7,8,.02) end
  if p.k==2 and p.l%3==0 then part(p.x,p.y,rnd(2)-1,rnd(2)-1,flr(10+rnd(5)),6,.03) end
  if p.l<=0 or p.y>104 then del(ps,p) end
 end
end

function draw_particles()
 for p in all(ps) do
  if p.l<8 and p.l%2<1 then
   pset(p.x,p.y,5)
  elseif p.k==3 then
   circfill(p.x,p.y,1,p.c)
  else
   pset(p.x,p.y,p.c)
   pset(p.x-p.dx,p.y-p.dy,5)
  end
 end
end

function job(fr,fn)
 add(jobs,{t+fr,fn})
end

function update_jobs()
 for j in all(jobs) do
  if t>=j[1] then
   j[2]()
   del(jobs,j)
  end
 end
end

function launch(i)
 local x=18+((i-1)%5)*23+rnd(6)
 if i==1 then fountain(x)
 elseif i==2 then roman(x)
 elseif i==3 then rocket(x,0)
 elseif i==4 then
  burst(64,40,30+pow*8,fw[i][2],0,.04)
  sfx(1)
 elseif i==5 then
  burst(64,39,38,fw[i][2],1,.025)
  sfx(1)
 elseif i==6 then
  burst(64,34,34,10,1,.09)
  sfx(1)
 elseif i==7 then palm(64,38)
 elseif i==8 then ring(64,40)
 elseif i==9 then crackle(64,40)
 else finale() end
end

function fountain(x)
 sfx(0)
 for n=0,24+pow*10 do
  job(n,function()
   part(x,96,rnd(2)-1,-(1.5+rnd(2.4)+pow*.4),flr(8+rnd(7)),22+rnd(14),.08,1)
  end)
 end
end

function roman(x)
 for n=0,3+pow do
  job(n*14,function()
   sfx(0)
   part(x,94,rnd(.8)-.4,-3.1-rnd(1.6),flr(8+rnd(7)),35,.02,3)
   job(24,function()
    burst(x+rnd(20)-10,32+rnd(20),14,flr(8+rnd(7)),0,.05)
    sfx(1)
   end)
  end)
 end
end

function rocket(x,mode)
 sfx(0)
 for n=0,18 do
  job(n,function() part(x,96,rnd(.7)-.35,-2.5-rnd(.5),7,20,.03) end)
 end
 job(34,function()
  local y=25+rnd(24)
  if mode==1 then
   ring(x,y)
  else
   burst(x,y,24+pow*7,flr(8+rnd(7)),0,.045)
   sfx(1)
  end
 end)
end

function burst(x,y,n,c,kind,g)
 for a=1,n do
  local r=.7+rnd(1.8)+pow*.25
  local ang=a/n
  part(x,y,cos(ang)*r,sin(ang)*r,c,30+rnd(18),g,kind)
 end
end

function ring(x,y)
 sfx(1)
 for a=1,38 do
  local ang=a/38
  part(x,y,cos(ang)*1.9,sin(ang)*1.9,11,34,.035,0)
 end
end

function palm(x,y)
 sfx(1)
 for a=.05,.95,.18 do
  for n=1,7 do
   part(x,y,cos(a)*(1+n*.24),sin(a)*(1+n*.24),12,34+n*2,.05,3)
  end
 end
end

function crackle(x,y)
 sfx(2)
 burst(x,y,18+pow*10,15,2,.04)
 for n=1,6+pow*3 do
  job(n*5,function()
   sparkle(x+rnd(50)-25,y+rnd(36)-18,8,flr(7+rnd(8)),2)
   sfx(2)
  end)
 end
end

function sparkle(x,y,n,c,kind)
 for i=1,n do part(x,y,rnd(2)-1,rnd(2)-1,c,10+rnd(8),.03,kind) end
end

function finale()
 for n=0,6+pow*2 do
  job(n*8,function() rocket(16+rnd(96),n%2) end)
 end
end

function _i18n_refs()
 if false then
  tx("title",0,0,0)
  tx("select",0,0,0)
  tx("fire",0,0,0)
  tx("inspect",0,0,0)
  tx("fountain",0,0,0)
  tx("roman",0,0,0)
  tx("shell",0,0,0)
  tx("peony",0,0,0)
  tx("chrys",0,0,0)
  tx("willow",0,0,0)
  tx("palm",0,0,0)
  tx("ring",0,0,0)
  tx("crackle",0,0,0)
  tx("finale",0,0,0)
  tx("d_fountain",0,0,0)
  tx("d_roman",0,0,0)
  tx("d_shell",0,0,0)
  tx("d_peony",0,0,0)
  tx("d_chrys",0,0,0)
  tx("d_willow",0,0,0)
  tx("d_palm",0,0,0)
  tx("d_ring",0,0,0)
  tx("d_crackle",0,0,0)
  tx("d_finale",0,0,0)
 end
end
