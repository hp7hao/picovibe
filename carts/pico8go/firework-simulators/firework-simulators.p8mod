pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- firework simulators
-- by hp7hao and codex

fw={
 {"n01","s01","e01",8,1,1},
 {"n02","s02","e02",10,2,2},
 {"n03","s03","e03",9,3,3},
 {"n04","s04","e04",12,4,4},
 {"n05","s05","e05",10,5,5},
 {"n06","s06","e06",8,5,6},
 {"n07","s07","e07",9,2,7},
 {"n08","s08","e08",10,6,8},
 {"n09","s09","e09",9,6,9},
 {"n10","s10","e10",8,7,10},
 {"n11","s11","e11",10,7,11},
 {"n12","s12","e12",11,7,12},
 {"n13","s13","e13",15,7,13},
 {"n14","s14","e14",12,8,14},
 {"n15","s15","e15",14,8,15},
 {"n16","s16","e16",9,8,16},
 {"n17","s17","e17",14,8,17},
 {"n18","s18","e18",7,8,18},
 {"n19","s19","e19",10,8,19},
 {"n20","s20","e20",8,9,20},
 {"n21","s21","e21",11,9,21},
 {"n22","s22","e22",9,3,22},
 {"n23","s23","e23",10,10,23},
 {"n24","s24","e24",7,8,24},
 {"n25","s25","e25",14,11,25},
 {"n26","s26","e26",10,11,26},
 {"n27","s27","e27",9,11,27},
 {"n28","s28","e28",12,11,28},
 {"n29","s29","e29",11,11,29},
 {"n30","s30","e30",9,11,30},
 {"n31","s31","e31",7,11,31},
 {"n32","s32","e32",15,11,32},
 {"n33","s33","e33",14,11,33},
 {"n34","s34","e34",10,11,34},
 {"n35","s35","e35",11,11,35},
 {"n36","s36","e36",12,11,36},
 {"n37","s37","e37",14,11,37},
 {"n38","s38","e38",10,11,38},
 {"n39","s39","e39",8,11,39},
 {"n40","s40","e40",10,11,40},
 {"n41","s41","e41",12,11,41},
 {"n42","s42","e42",11,11,42},
 {"n43","s43","e43",14,11,43},
 {"n44","s44","e44",8,11,44},
 {"n45","s45","e45",7,11,45},
 {"n46","s46","e46",14,12,46},
 {"n47","s47","e47",10,12,47},
 {"n48","s48","e48",8,13,48},
 {"n49","s49","e49",9,14,49},
 {"n50","s50","e50",14,12,50}
}

function _init()
 _txi()
 sel=1
 pow=2
 t=0
 mode="preview"
 spin=0
 info=1
 ps={}
 jobs={}
 stars={}
 for i=1,46 do
  add(stars,{rnd(128),rnd(66),rnd(2)})
 end
end

function _update()
 t+=1
 if btnp(0) then
  sel=(sel+48)%50+1
  mode="preview"
  ps={}
  jobs={}
 end
 if btnp(1) then
  sel=sel%50+1
  mode="preview"
  ps={}
  jobs={}
 end
 if btnp(2) then pow=min(3,pow+1) end
 if btnp(3) then pow=max(1,pow-1) end
 if btnp(4) then mode="launched" launch(fw[sel][6]) end
 if btnp(5) then info=3-info end
 update_jobs()
 update_particles()
 if mode=="launched" and #ps==0 and #jobs==0 then mode="preview" end
 spin=(spin+.006)%1
end

function _draw()
 cls(0)
 if mode=="preview" then draw_preview() else draw_sky() draw_particles() end
 rectfill(0,100,127,127,1)
 line(0,100,127,100,5)
 tx("title",2,2,7)
 print("< >",2,111,6)
 tx("select",17,111,6)
 print("x",64,111,8)
 tx("fire",73,111,8)
 print("o",101,111,12)
 tx("inspect",110,111,12)
 draw_panel()
end

-- compact low-poly casing renderer
function draw_preview()
 spin=(time()*.15)%1
 rectfill(0,9,127,81,1)
 for y=10,80,12 do line(0,y,127,y,0) end
 ovalfill(34,73,94,79,0)
 draw_mesh(fw[sel][5])
end

function p3(x,y,z)
 local xx=x*cos(spin)-z*sin(spin)
 local zz=x*sin(spin)+z*cos(spin)
 return {64+xx,46+y*.72-zz*.22,zz}
end
function filltri(a,b,c,col)
 local ya=flr(min(a[2],min(b[2],c[2])))
 local yb=-flr(-max(a[2],max(b[2],c[2])))
 for y=max(9,ya),min(81,yb) do
  local q={}
  local e={{a,b},{b,c},{c,a}}
  for z in all(e) do
   local u=z[1]
   local v=z[2]
   if y>=min(u[2],v[2]) and y<max(u[2],v[2]) and u[2]!=v[2] then add(q,u[1]+(y-u[2])*(v[1]-u[1])/(v[2]-u[2])) end
  end
  if #q==2 then line(min(q[1],q[2]),y,max(q[1],q[2]),y,col) end
 end
end
function face4(a,b,c,d,col)
 filltri(a,b,c,col)
 filltri(a,c,d,col)
 line(a[1],a[2],b[1],b[2],0)
 line(b[1],b[2],c[1],c[2],0)
end
function prism(y1,y2,r1,r2,col,n)
 local a={}
 local b={}
 local f={}
 n=n or 6
 for i=0,n-1 do
  add(a,p3(cos(i/n)*r1,y1,sin(i/n)*r1))
  add(b,p3(cos(i/n)*r2,y2,sin(i/n)*r2))
 end
 for i=1,n do
  local j=i%n+1
  add(f,{a[i],a[j],b[j],b[i],(a[i][3]+a[j][3]+b[j][3]+b[i][3])/4,col+(i%3==0 and 1 or 0)})
 end
 for i=1,#f do
  for j=i+1,#f do
   if f[i][5]>f[j][5] then
    local q=f[i]
    f[i]=f[j]
    f[j]=q
   end
  end
 end
 for q in all(f) do face4(q[1],q[2],q[3],q[4],q[6]) end
 filltri(b[1],b[3],b[5],col+2)
 filltri(b[1],b[5],b[n],col+2)
end
function draw_mesh(i)
 if i==1 then
  prism(-5,5,7,7,8,6)
 elseif i==2 then
  prism(-8,8,8,8,10,6)
  local a=p3(-8,8,0)
  local b=p3(-26,25,0)
  local c=p3(8,-8,0)
  local d=p3(27,-24,0)
  line(a[1],a[2],b[1],b[2],7)
  line(c[1],c[2],d[1],d[2],7)
 elseif i==3 then
  prism(-20,20,8,8,8,6)
  prism(-22,-19,5,8,10,6)
 elseif i==4 then
  prism(-10,10,17,17,5,8)
  prism(-13,-10,14,17,6,8)
 elseif i==5 then
  prism(-29,29,2,2,10,6)
 elseif i==6 then
  prism(-3,3,22,22,10,8)
  prism(-22,22,3,3,7,6)
 elseif i==7 then
  prism(-24,20,7,20,8,8)
  prism(-28,-24,3,7,10,6)
 elseif i==8 then
  prism(-25,25,12,12,8,8)
  prism(-28,-24,15,15,10,8)
 elseif i==9 then
  prism(-12,17,10,10,8,6)
  prism(-26,-12,2,10,9,6)
  local a=p3(0,17,0)
  local b=p3(0,34,0)
  line(a[1],a[2],b[1],b[2],7)
 elseif i==10 then
  prism(-8,8,8,8,10,6)
  local a=p3(-27,0,0)
  local b=p3(27,0,0)
  line(a[1],a[2],b[1],b[2],7)
 elseif i==11 then
  prism(-28,5,15,15,5,8)
  prism(5,22,15,5,8,8)
 elseif i==12 then
  prism(-18,22,25,20,12,4)
  prism(-29,-14,18,18,9,8)
 elseif i==13 then
  prism(-4,4,25,25,8,12)
  prism(-29,29,3,3,5,6)
 else
  local a=p3(-28,-25,0)
  local b=p3(-22,25,0)
  local c=p3(28,-25,0)
  local d=p3(22,25,0)
  line(a[1],a[2],b[1],b[2],5)
  line(b[1],b[2],d[1],d[2],5)
  line(d[1],d[2],c[1],c[2],5)
  for x=-18,18,9 do prism(-18,18,2,2,9,6) end
 end
end

function draw_sky()
 for s in all(stars) do
  pset(s[1],s[2],s[3]+5)
 end
 for x=0,127,8 do
  line(x,101,x+4,97,5)
 end
end

function draw_panel()
 local f=fw[sel]
 rectfill(0,82,127,99,0)
 rect(0,82,127,99,5)
 tx(f[1],3,85,f[4])
 print(sel.."/50",101,85,7)
 tx(info==1 and f[2] or f[3],3,93,6)
 print(info==1 and "s" or "fx",118,93,5)
end

function part(x,y,dx,dy,c,life,g,kind)
 if #ps<220 then
  add(ps,{x=x,y=y,dx=dx,dy=dy,c=c,l=life,g=g or .04,k=kind or 0})
 end
end

function update_particles()
 for p in all(ps) do
  p.x+=p.dx
  p.y+=p.dy
  p.dy+=p.g
  p.l-=1
  if p.k==1 and p.l%6==0 then part(p.x,p.y,rnd(1)-.5,rnd(1)-.5,7,8,.02) end
  if p.k==2 and p.l%4==0 then part(p.x,p.y,rnd(2)-1,rnd(2)-1,flr(10+rnd(5)),6,.03) end
  if p.l<=0 or p.y>104 then del(ps,p) end
 end
end

function draw_particles()
 for p in all(ps) do
  if p.l<8 and p.l%2<1 then
   pset(p.x,p.y,5)
  elseif p.k==4 then
   circfill(p.x,p.y,2,p.c)
  elseif p.k==3 then
   circfill(p.x,p.y,1,p.c)
  elseif p.k==5 then
   if p.l%6<3 then circfill(p.x,p.y,1,p.c) end
  else
   pset(p.x,p.y,p.c)
   pset(p.x-p.dx,p.y-p.dy,5)
  end
 end
end

function job(fr,fn)
 add(jobs,{t+fr,fn})
end

function update_jobs()
 for j in all(jobs) do
  if t>=j[1] then
   j[2]()
   del(jobs,j)
  end
 end
end

function launch(i)
 local x=32+rnd(64)
 if i<=3 then snapper(x,i)
 elseif i==4 then smoke(x)
 elseif i<=7 then stickfx(x,i)
 elseif i<=9 then wheel(i)
 elseif i<=13 then fountain(x,i)
 elseif i<=16 then battery(x,i)
 elseif i<=19 then mine(x,i)
 elseif i<=24 then lift(i,x)
 elseif i==46 then shell_combo()
 elseif i==47 then fan_cake()
 elseif i==48 then wheel(i)
 elseif i==49 then waterfall()
 elseif i==50 then finale()
 else shell(i,x) end
end

function snapper(x,k)
 sfx(2)
 for i=1,5+k*3 do part(x,92,rnd(2)-1,-rnd(2),8+k,8+rnd(8),.12,k==2 and 3 or 0) end
 if k==3 then
  for q=1,4+pow do
   job(q*6,function() sfx(2) sparkle(x+rnd(20)-10,90,5,9,0) end)
  end
 end
end

function smoke(x)
 sfx(0)
 for q=0,55 do
  local n=q
  job(n,function() part(x+rnd(8)-4,92-n*.35,rnd(.5)-.25,-.15-rnd(.2),flr(5+rnd(2)),30+rnd(18),-.01,4) end)
 end
end

function stickfx(x,k)
 sfx(0)
 for q=0,35+pow*6 do
  local n=q
  job(n,function()
   local xx=k==7 and 24+n*2.1 or x
   part(xx,84+(k==7 and sin(n/12)*5 or 0),rnd(2)-1,-rnd(1.4),k==6 and flr(8+n/8%6) or 10,10+rnd(10),.05,k==7 and 2 or 1)
  end)
 end
end

function wheel(k)
 sfx(0)
 local dur=k==48 and 90 or 45
 for q=0,dur do
  local n=q
  job(n,function()
   local a=n/18
   local x=64+(k==9 and sin(n/31)*35 or 0)
   local y=k==48 and 53 or 86
   for r=0,(k==48 and 3 or 1) do
    part(x+cos(a+r/4)*12,y+sin(a+r/4)*12,cos(a+r/4)*1.4,sin(a+r/4)*1.4,8+r*2,16,.03,1)
   end
  end)
 end
end

function fountain(x,k)
 sfx(0)
 for q=0,28+pow*10 do
  local n=q
  job(n,function()
   local c=k==12 and flr(8+n/9%7) or (k==13 and 15 or 10)
   part(x,96,rnd(2.4)-1.2,-(1.5+rnd(2.5)+pow*.35),c,20+rnd(12),.09,k==13 and 2 or 1)
   if k==13 and n%12==0 then sfx(2) end
  end)
 end
end

function battery(x,k)
 if k==16 then
  for p=-1,1 do fountain(64+p*24,11+p%2) end
 else
  local count=k==15 and 7+pow*2 or 4+pow
  for q=0,count do
   local n=q
   job(n*12,function()
    local xx=k==15 and 36+(n%3)*28 or x
    sfx(0)
    comet(xx,94,24,flr(8+n%7))
    job(19,function() boom(xx,36+rnd(18),12,flr(8+rnd(7)),0,.05,1) end)
   end)
  end
 end
end

function mine(x,k)
 sfx(0)
 if k==18 then
  for a=0,1,.08 do part(x,65,cos(a)*1.3,-.5+abs(sin(a))*.7,7,48,.035,4) end
 elseif k==17 then
  for i=1,36 do part(x,92,rnd(3)-1.5,-2-rnd(2),flr(8+rnd(7)),30+rnd(15),.09,3) end
 else
  for i=1,28 do part(x,92,rnd(2.8)-1.4,-2-rnd(2.6),flr(8+rnd(7)),28+rnd(18),.08,1) end
 end
end

function lift(k,x)
 sfx(0)
 if k==22 then snapper(x,1) end
 for q=0,27 do
  local n=q
  job(n,function()
   local a=k==23 and n/10 or .75
   local xx=x+(k==23 and cos(a)*12 or 0)
   part(xx,96-n*2.2,rnd(.6)-.3,.2,7,16,.02,k==23 and 1 or 0)
   if k==21 and n%8==0 then sfx(0) end
  end)
 end
 if k!=24 then
  job(30,function()
   if k==23 then air(29,x,35)
   elseif k==22 then air(25,x,38)
   else air(k==21 and 31 or 25,x,34) end
  end)
 end
end

function comet(x,y,n,c)
 for i=1,n do part(x+rnd(3)-1.5,y-i*2,rnd(.4)-.2,.2,c,18+i/2,.025,1) end
end

function shell(k,x)
 sfx(0)
 comet(x,96,27,k==45 and 9 or 7)
 job(28,function() air(k,x,28+rnd(20)) end)
end

function boom(x,y,n,c,k,g,v)
 sfx(k==2 and 2 or 1)
 for a=1,n do
  local r=(.65+rnd(1.1))*(v or 1)+pow*.12
  part(x,y,cos(a/n)*r,sin(a/n)*r,c,28+rnd(18),g or .04,k or 0)
 end
end

function ring(x,y,n,c,v,k)
 sfx(1)
 for a=1,n do part(x,y,cos(a/n)*v,sin(a/n)*v,c,38,.035,k or 0) end
end

function palm(x,y,c)
 sfx(1)
 for a=.05,.95,.18 do
  for n=1,7 do part(x,y,cos(a)*(1+n*.23),sin(a)*(1+n*.23),c,34+n*2,.055,3) end
 end
end

function crackle(x,y)
 sfx(2)
 boom(x,y,18+pow*8,15,2,.04,1)
 for q=1,5+pow*2 do
  job(q*5,function()
   sparkle(x+rnd(46)-23,y+rnd(32)-16,7,flr(8+rnd(7)),2)
   sfx(2)
  end)
 end
end

function sparkle(x,y,n,c,kind)
 for i=1,n do part(x,y,rnd(2)-1,rnd(2)-1,c,10+rnd(8),.03,kind) end
end

function air(k,x,y)
 if k==25 then boom(x,y,30+pow*6,14,0,.04,1)
 elseif k==26 then boom(x,y,38+pow*5,10,1,.025,1.05)
 elseif k==27 then boom(x,y,34+pow*5,9,1,.09,.9)
 elseif k==28 then palm(x,y,12)
 elseif k==29 then ring(x,y,38,11,1.9,0)
 elseif k==30 then boom(x,y,44+pow*5,9,1,.075,1.1)
 elseif k==31 then boom(x,y,34+pow*5,7,5,.035,1)
 elseif k==32 then
  boom(x,y,26,14,0,.04,1)
  job(8,function() crackle(x,y) end)
 elseif k==33 then
  boom(x,y,24,8,0,.04,.8)
  job(7,function() ring(x,y,30,14,1.8,0) end)
 elseif k==34 then
  boom(x,y,30,14,0,.04,1.1)
  boom(x,y,24,10,1,.025,.65)
 elseif k==35 then
  ring(x,y,34,8,1.3,0)
  ring(x,y,42,11,2.1,0)
 elseif k==36 then
  ring(x,y,26,12,.8,0)
  ring(x,y,32,10,1.45,1)
  ring(x,y,38,14,2.1,0)
 elseif k==37 then
  boom(x,y,28,14,0,.04,1)
  job(18,function() boom(x+12,y+10,30,10,1,.04,1.1) end)
 elseif k==38 then
  boom(x,y,24,8,0,.04,.8)
  job(14,function() boom(x-12,y+8,28,10,1,.04,1) end)
  job(28,function() boom(x+12,y+14,34,14,0,.04,1.2) end)
 elseif k==39 then heart(x,y)
 elseif k==40 then smiley(x,y)
 elseif k==41 then cube(x,y)
 elseif k==42 then jelly(x,y)
 elseif k==43 then phoenix(x,y)
 elseif k==44 then
  ring(x,y,42,8,2,2)
  job(5,function() ring(x,y,34,10,1.55,1) end)
 elseif k==45 then
  boom(x,y,42,9,1,.075,1.1)
  job(6,function() boom(x,y,32,7,5,.035,.9) end)
 end
end

function heart(x,y)
 sfx(1)
 for a=0,1,.035 do
  local xx=sin(a)^3*2.1
  local yy=-(13*cos(a)-5*cos(a*2)-2*cos(a*3)-cos(a*4))*.12
  part(x,y,xx,yy,8,40,.025,1)
 end
end

function smiley(x,y)
 ring(x,y,36,10,2,0)
 for i=-1,1,2 do part(x,y,i*.65,-.65,7,38,.035,3) end
 for a=.1,.4,.05 do part(x,y,cos(a)*1.2,.9+sin(a)*.6,7,38,.035,3) end
end

function cube(x,y)
 sfx(1)
 for xx=-1,1,2 do
  for yy=-1,1,2 do
   part(x,y,xx*1.45+yy*.4,yy*1.45,12,42,.03,3)
   part(x,y,xx*1.45-yy*.4,yy*.7,12,42,.03,1)
  end
 end
end

function jelly(x,y)
 sfx(1)
 for a=0,.5,.035 do part(x,y,cos(a)*2,sin(a)*1.5,11,36,.045,1) end
 for xx=-2,2 do
  for n=1,5 do part(x+xx*7,y,xx*.12,n*.35,10,34+n*3,.055,1) end
 end
end

function phoenix(x,y)
 sfx(1)
 for side=-1,1,2 do
  for n=1,11 do part(x,y,side*(.3+n*.18),-1.5+abs(6-n)*.2,14,32+n,.045,1) end
 end
 for n=1,8 do part(x,y,(n%2-.5)*.4,1+n*.18,8,34+n,.06,1) end
end

function shell_combo()
 for q=0,6+pow do
  local n=q
  job(n*12,function() shell(25+n%6,18+(n%4)*30) end)
 end
end

function fan_cake()
 for q=0,7+pow do
  local n=q
  job(n*9,function() shell(25+n%5,64+(n%3-1)*(22+n*2)) end)
 end
end

function waterfall()
 sfx(0)
 for q=0,85 do
  local n=q
  job(n,function()
   for x=8,120,14 do part(x,18,rnd(.6)-.3,.6+rnd(1.1),9,50,.025,1) end
  end)
 end
end

function finale()
 for q=0,10+pow*2 do
  local n=q
  job(n*8,function()
   shell(25+n%21,14+rnd(100))
   if n>7 and n%2==0 then crackle(20+rnd(88),28+rnd(35)) end
  end)
 end
end
__gfx__
